# Supabase Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Optional server-side service role key (bypasses RLS for server actions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-optional

# Meta Conversions API (CAPI) & Pixel
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id-here
META_ACCESS_TOKEN=your-meta-conversions-api-access-token
NEXT_PUBLIC_APP_URL=https://your-domain.com

# n8n AI Chat Webhook (optional override for production)
N8N_CHAT_WEBHOOK_URL=https://n8n.srv1106977.hstgr.cloud/webhook-test/bc6dd186-3686-457e-a99c-8ca230c51abf

